{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@velxio/*": [
        "./vendor/velxio/frontend/src/*"
      ]
    },
    "moduleDetection": "force"
  },
  "include": [
    "src"
  ]
}
