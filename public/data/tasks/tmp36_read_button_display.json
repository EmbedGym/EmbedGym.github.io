");\n}\n\nvoid loop() {\n  if (pressed) {\n    pressed = false;\n    int adc = analogRead(TMP36_PIN);\n    float c = (adc * 5.0 / 1023.0 - 0.5) * 100.0;\n    int f = (int)round(c * 9.0 / 5.0 + 32.0);\n    lcd.clear();\n    lcd.print(\"Temp: \");\n    lcd.print(f);\n    lcd.print(\" F\");\n  }\n}\n","overlays":{},"referenceHex":null},"atmega2560_arduino":{"circuit":{"boards":[{"id":"arduino-mega","boardKind":"arduino-mega","x":100,"y":200}],"components":[{"id":"BTN","metadataId":"pushbutton","x":100,"y":135},{"id":"R_PD","metadataId":"resistor-10k","x":187,"y":169},{"id":"T1","metadataId":"tmp36","x":266,"y":104},{"id":"LCD1","metadataId":"lcd1602","x":346,"y":44}],"wires":[{"id":"w-2-BTN","start":{"componentId":"arduino-mega","pinName":"2","x":0,"y":0},"end":{"componentId":"BTN","pinName":"1.l","x":0,"y":0},"color":"#0000ff","waypoints":[]},{"id":"w-BTN-5V","start":{"componentId":"BTN","pinName":"2.l","x":0,"y":0},"end":{"componentId":"arduino-mega","pinName":"5V","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-2-RPD","start":{"componentId":"arduino-mega","pinName":"2","x":0,"y":0},"end":{"componentId":"R_PD","pinName":"1","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-RPD-GND","start":{"componentId":"R_PD","pinName":"2","x":0,"y":0},"end":{"componentId":"arduino-mega","pinName":"GND","x":0,"y":0},"color":"#000000","waypoints":[]},{"id":"w-A0-Vout","start":{"componentId":"arduino-mega","pinName":"A0","x":0,"y":0},"end":{"componentId":"T1","pinName":"Vout","x":0,"y":0},"color":"#00aaff","waypoints":[]},{"id":"w-5V-T1","start":{"componentId":"arduino-mega","pinName":"5V","x":0,"y":0},"end":{"componentId":"T1","pinName":"VCC","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-T1-GND","start":{"componentId":"T1","pinName":"GND","x":0,"y":0},"end":{"componentId":"arduino-mega","pinName":"GND","x":0,"y":0},"color":"#000000","waypoints":[]},{"id":"w-12-RS","start":{"componentId":"arduino-mega","pinName":"12","x":0,"y":0},"end":{"componentId":"LCD1","p