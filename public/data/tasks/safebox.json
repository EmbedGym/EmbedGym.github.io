tion(RELAY_PIN, GPIO_MODE_OUTPUT);\n    gpio_set_level(RELAY_PIN, 0);\n\n    char entered[5] = \"\";\n    int pos = 0;\n    char last_key = 0;\n\n    for (;;) {\n        char key = scan_key();\n        if (key != 0 && last_key == 0) {\n            entered[pos++] = key;\n            if (pos == 4) {\n                entered[4] = '\\0';\n                gpio_set_level(RELAY_PIN, strcmp(entered, PASSWORD) == 0 ? 1 : 0);\n                pos = 0;\n            }\n        }\n        last_key = key;\n        vTaskDelay(pdMS_TO_TICKS(20));\n    }\n}\n","overlays":{},"referenceHex":null},"nrf52840_arduino":{"circuit":{"boards":[{"id":"nrf52840-dk","boardKind":"nrf52840-dk","x":60,"y":60}],"components":[{"id":"KP1","metadataId":"membrane-keypad","x":60,"y":440},{"id":"RLY1","metadataId":"relay-module","x":760,"y":320}],"wires":[{"id":"w-P1.08-R1","start":{"componentId":"nrf52840-dk","pinName":"P1.08","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.01-R2","start":{"componentId":"nrf52840-dk","pinName":"P1.01","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R2","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.02-R3","start":{"componentId":"nrf52840-dk","pinName":"P1.02","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R3","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.27-R4","start":{"componentId":"nrf52840-dk","pinName":"P0.27","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.21-C1","start":{"componentId":"nrf52840-dk","pinName":"P0.21","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C1","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P0.23-C2","start":{"componentId":"nrf52840-dk","pinName":"P0.23","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C2","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P1.14-C3","start":{"componentId":"nrf52840-dk","pinName":"P1.14","x":0,"y":0},"end":{"componentId":"KP1","