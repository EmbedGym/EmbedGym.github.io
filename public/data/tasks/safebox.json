inMode(RELAY_PIN, OUTPUT);\n  digitalWrite(RELAY_PIN, LOW);\n}\n\nvoid loop() {\n  char key = scanKey();\n  if (key != 0 && lastKey == 0) {\n    entered[pos] = key;\n    pos++;\n    if (pos == 4) {\n      entered[4] = '\\0';\n      digitalWrite(RELAY_PIN, strcmp(entered, PASSWORD) == 0 ? HIGH : LOW);\n      pos = 0;\n    }\n  }\n  lastKey = key;\n  delay(20);\n}\n","overlays":{},"referenceHex":null},"esp32s3_arduino":{"circuit":{"boards":[{"id":"esp32-s3","boardKind":"esp32-s3","x":60,"y":60}],"components":[{"id":"KP1","metadataId":"membrane-keypad","x":300,"y":60},{"id":"RLY1","metadataId":"relay-module","x":300,"y":420}],"wires":[{"id":"w-9-R1","start":{"componentId":"esp32-s3","pinName":"9","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-10-R2","start":{"componentId":"esp32-s3","pinName":"10","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R2","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-11-R3","start":{"componentId":"esp32-s3","pinName":"11","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R3","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-13-R4","start":{"componentId":"esp32-s3","pinName":"13","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-14-C1","start":{"componentId":"esp32-s3","pinName":"14","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C1","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-12-C2","start":{"componentId":"esp32-s3","pinName":"12","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C2","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-43-C3","start":{"componentId":"esp32-s3","pinName":"43","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C3","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-44-C4","start":{"componentId":"esp32-s3","pinName":"44","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C4","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-21-IN","start":{"