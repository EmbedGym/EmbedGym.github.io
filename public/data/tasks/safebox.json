H);\n  }\n  for (int c = 0; c < 4; c++) {\n    pinMode(colPins[c], INPUT_PULLUP);\n  }\n  pinMode(RELAY_PIN, OUTPUT);\n  digitalWrite(RELAY_PIN, LOW);\n}\n\nvoid loop() {\n  char key = scanKey();\n  if (key != 0 && lastKey == 0) {\n    entered[pos] = key;\n    pos++;\n    if (pos == 4) {\n      entered[4] = '\\0';\n      digitalWrite(RELAY_PIN, strcmp(entered, PASSWORD) == 0 ? HIGH : LOW);\n      pos = 0;\n    }\n  }\n  lastKey = key;\n  delay(20);\n}\n","overlays":{},"referenceHex":null},"atmega2560_arduino":{"circuit":{"boards":[{"id":"arduino-mega","boardKind":"arduino-mega","x":100,"y":200}],"components":[{"id":"KP1","metadataId":"membrane-keypad","x":100,"y":412},{"id":"RLY1","metadataId":"relay-module","x":100,"y":108}],"wires":[{"id":"w-9-R1","start":{"componentId":"arduino-mega","pinName":"9","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-8-R2","start":{"componentId":"arduino-mega","pinName":"8","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R2","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-7-R3","start":{"componentId":"arduino-mega","pinName":"7","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R3","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-6-R4","start":{"componentId":"arduino-mega","pinName":"6","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-5-C1","start":{"componentId":"arduino-mega","pinName":"5","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C1","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-4-C2","start":{"componentId":"arduino-mega","pinName":"4","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C2","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-3-C3","start":{"componentId":"arduino-mega","pinName":"3","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C3","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-2-C4","start":{"componentId":"arduino-mega","pinName":"2","x":0