HIGH);\n  }\n  return key;\n}\n\nvoid setup() {\n  for (int r = 0; r < 4; r++) {\n    pinMode(rowPins[r], OUTPUT);\n    digitalWrite(rowPins[r], HIGH);\n  }\n  for (int c = 0; c < 4; c++) {\n    pinMode(colPins[c], INPUT_PULLUP);\n  }\n  pinMode(RELAY_PIN, OUTPUT);\n  digitalWrite(RELAY_PIN, LOW);\n}\n\nvoid loop() {\n  char key = scanKey();\n  if (key != 0 && lastKey == 0) {\n    entered[pos] = key;\n    pos++;\n    if (pos == 4) {\n      entered[4] = '\\0';\n      digitalWrite(RELAY_PIN, strcmp(entered, PASSWORD) == 0 ? HIGH : LOW);\n      pos = 0;\n    }\n  }\n  lastKey = key;\n  delay(20);\n}\n","overlays":{},"referenceHex":null},"nrf52840_zephyr":{"circuit":{"boards":[{"id":"nrf52840-dk","boardKind":"nrf52840-dk","x":60,"y":60}],"components":[{"id":"KP1","metadataId":"membrane-keypad","x":60,"y":440},{"id":"RLY1","metadataId":"relay-module","x":760,"y":320}],"wires":[{"id":"w-P1.08-R1","start":{"componentId":"nrf52840-dk","pinName":"P1.08","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.01-R2","start":{"componentId":"nrf52840-dk","pinName":"P1.01","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R2","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.02-R3","start":{"componentId":"nrf52840-dk","pinName":"P1.02","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R3","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.27-R4","start":{"componentId":"nrf52840-dk","pinName":"P0.27","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.21-C1","start":{"componentId":"nrf52840-dk","pinName":"P0.21","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C1","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P0.23-C2","start":{"componentId":"nrf52840-dk","pinName":"P0.23","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C2","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P1.14-C3","start":{"componentId":"nrf52840-dk","pi