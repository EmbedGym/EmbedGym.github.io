intf(buf, sizeof(buf), \"%04d/%02d/%02d %02d:%02d:%02d\",\n           now.year(), now.month(), now.day(), now.hour(), now.minute(), now.second());\n  Serial.println(buf);\n}\n","overlays":{},"referenceHex":null},"esp32s3_espidf":{"circuit":{"boards":[{"id":"esp32-s3","boardKind":"esp32-s3","x":60,"y":60}],"components":[{"id":"RTC1","metadataId":"ds1307","x":400,"y":80},{"id":"LS1","metadataId":"level-shifter","x":240,"y":200}],"wires":[{"id":"w-38-LV1","start":{"componentId":"esp32-s3","pinName":"38","x":0,"y":0},"end":{"componentId":"LS1","pinName":"LV1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-HV1-SDA","start":{"componentId":"LS1","pinName":"HV1","x":0,"y":0},"end":{"componentId":"RTC1","pinName":"SDA","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-39-LV2","start":{"componentId":"esp32-s3","pinName":"39","x":0,"y":0},"end":{"componentId":"LS1","pinName":"LV2","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-HV2-SCL","start":{"componentId":"LS1","pinName":"HV2","x":0,"y":0},"end":{"componentId":"RTC1","pinName":"SCL","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-5V-HV","start":{"componentId":"esp32-s3","pinName":"5V","x":0,"y":0},"end":{"componentId":"LS1","pinName":"HV","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-3V3-LV","start":{"componentId":"esp32-s3","pinName":"3V3.1","x":0,"y":0},"end":{"componentId":"LS1","pinName":"LV","x":0,"y":0},"color":"#ff8800","waypoints":[]},{"id":"w-LS1-GND","start":{"componentId":"LS1","pinName":"GND.1","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"GND.1","x":0,"y":0},"color":"#000000","waypoints":[]},{"id":"w-5V-5V","start":{"componentId":"esp32-s3","pinName":"5V","x":0,"y":0},"end":{"componentId":"RTC1","pinName":"5V","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-RTC1-GND","start":{"componentId":"RTC1","pinName":"GND","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"GND.1","x":0,"y":0},"color":"#000000","waypoints":[]}]},"pinout":{"DS1307":{"SDA":"GPI