s - previousMillis >= interval) {\n    previousMillis = currentMillis;\n    \n    Serial.print(\"Raw: \");\n    Serial.print(analogValue);\n    Serial.print(\" Gas: \");\n    Serial.println(gasDetected ? \"DETECTED\" : \"clear\");\n  }\n}","overlays":{},"referenceHex":null},"esp32s3_arduino":{"circuit":{"boards":[{"id":"esp32-s3","boardKind":"esp32-s3","x":60,"y":60}],"components":[{"id":"GAS1","metadataId":"mq2","x":320,"y":60},{"id":"R_TOP","metadataId":"resistor","x":420,"y":200,"properties":{"value":"100k"}},{"id":"R_BOT","metadataId":"resistor","x":420,"y":280,"properties":{"value":"150k"}},{"id":"LS1","metadataId":"level-shifter","x":220,"y":260}],"wires":[{"id":"w0","start":{"componentId":"GAS1","pinName":"VCC","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"5V","x":0,"y":0},"color":"#dd3333","waypoints":[]},{"id":"w1","start":{"componentId":"GAS1","pinName":"GND","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"GND.1","x":0,"y":0},"color":"#333333","waypoints":[]},{"id":"w2","start":{"componentId":"GAS1","pinName":"AO","x":0,"y":0},"end":{"componentId":"R_TOP","pinName":"1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w3","start":{"componentId":"R_TOP","pinName":"2","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w4","start":{"componentId":"R_BOT","pinName":"1","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w5","start":{"componentId":"R_BOT","pinName":"2","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"GND.1","x":0,"y":0},"color":"#333333","waypoints":[]},{"id":"w6","start":{"componentId":"GAS1","pinName":"DO","x":0,"y":0},"end":{"componentId":"LS1","pinName":"HV1","x":0,"y":0},"color":"#0000ff","waypoints":[]},{"id":"w7","start":{"componentId":"LS1","pinName":"LV1","x":0,"y":0},"end":{"componentId":"esp32-s3","pinName":"5","x":0,"y":0},"color":"#0000ff","waypoints":[]},{"id":"w8","start":{"compone