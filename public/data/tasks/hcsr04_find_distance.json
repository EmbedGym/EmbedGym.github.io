0,"expect":"@dist[-1] >= 98 && @dist[-1] <= 102"},{"at":1500,"expect":"@dist.t[-1] > 600"}],"testOrigin":"tasks/hcsr04_find_distance/test.jsonl","testSha256":"5396ff330befb532a765dda620af3723b3ef6be57dc828a63638f4bb5c62017d","source":"const int TRIG_PIN = 43;\nconst int ECHO_PIN = 44;\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(TRIG_PIN, OUTPUT);\n  pinMode(ECHO_PIN, INPUT);\n  digitalWrite(TRIG_PIN, LOW);\n}\n\nvoid loop() {\n  digitalWrite(TRIG_PIN, LOW);\n  delayMicroseconds(2);\n  digitalWrite(TRIG_PIN, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(TRIG_PIN, LOW);\n\n  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 30000);\n  if (duration > 0) {\n    int distance = (int)(duration * 0.0343f / 2.0f + 0.5f);\n    Serial.printf(\"Distance: %d cm\\n\", distance);\n  }\n  delay(500);\n}\n","overlays":{},"referenceHex":null},"esp32s3_espidf":{"circuit":{"boards":[{"id":"esp32-s3","boardKind":"esp32-s3","x":60,"y":60}],"components":[{"id":"US1","metadataId":"hc-sr04","x":300,"y":60},{"id":"LS1","metadataId":"level-shifter","x":220,"y":180}],"wires":[{"id":"w-43-TRIG","start":{"componentId":"esp32-s3","pinName":"43","x":0,"y":0},"end":{"componentId":"US1","pinName":"TRIG","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-44-LV1","start":{"componentId":"esp32-s3","pinName":"44","x":0,"y":0},"end":{"componentId":"LS1","pinName":"LV1","x":0,"y":0},"color":"#0000ff","waypoints":[]},{"id":"w-HV1-ECHO","start":{"componentId":"LS1","pinName":"HV1","x":0,"y":0},"end":{"componentId":"US1","pinName":"ECHO","x":0,"y":0},"color":"#0000ff","waypoints":[]},{"id":"w-5V-HV","start":{"componentId":"esp32-s3","pinName":"5V","x":0,"y":0},"end":{"componentId":"LS1","pinName":"HV","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-3V3-LV","start":{"componentId":"esp32-s3","pinName":"3V3.1","x":0,"y":0},"end":{"componentId":"LS1","pinName":"LV","x":0,"y":0},"color":"#ff8800","waypoints":[]},{"id":"w-LS1-GND","start":{"componentId":"LS1","pinName":"GND.1","x":0,"y":0}