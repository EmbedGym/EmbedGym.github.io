t) {\n    setMotors(0, 0);\n    action = \"stop\";\n  } else if (left && right) {\n    setMotors(190, 220);\n    action = \"forward\";\n  }\n  Serial.print(\"Left: \");\n  Serial.print(left);\n  Serial.print(\" Mid: \");\n  Serial.print(middle);\n  Serial.print(\" Right: \");\n  Serial.print(right);\n  Serial.print(\" Action: \");\n  Serial.println(action);\n  delay(100);\n}\n","overlays":{},"referenceHex":null},"atmega2560_arduino":{"circuit":{"boards":[{"id":"arduino-mega","boardKind":"arduino-mega","x":100,"y":100}],"components":[{"id":"DRIVER","metadataId":"l298n","x":550,"y":80,"properties":{"enaJumper":false,"enbJumper":false,"regulatorJumper":true,"sampleWindowMs":1000}},{"id":"BATTERY","metadataId":"battery-9v","x":550,"y":310},{"id":"SENSOR","metadataId":"line-sensor","x":780,"y":80,"properties":{"thresholdPosition":0.5,"leftPhotocurrentUa":300,"middlePhotocurrentUa":200,"rightPhotocurrentUa":300}}],"wires":[{"id":"w0","start":{"componentId":"arduino-mega","pinName":"5","x":0,"y":0},"end":{"componentId":"DRIVER","pinName":"IN1","x":0,"y":0},"color":"#4499cc","waypoints":[]},{"id":"w1","start":{"componentId":"arduino-mega","pinName":"6","x":0,"y":0},"end":{"componentId":"DRIVER","pinName":"IN2","x":0,"y":0},"color":"#4499cc","waypoints":[]},{"id":"w2","start":{"componentId":"arduino-mega","pinName":"7","x":0,"y":0},"end":{"componentId":"DRIVER","pinName":"ENA","x":0,"y":0},"color":"#4499cc","waypoints":[]},{"id":"w3","start":{"componentId":"arduino-mega","pinName":"8","x":0,"y":0},"end":{"componentId":"DRIVER","pinName":"IN3","x":0,"y":0},"color":"#4499cc","waypoints":[]},{"id":"w4","start":{"componentId":"arduino-mega","pinName":"9","x":0,"y":0},"end":{"componentId":"DRIVER","pinName":"IN4","x":0,"y":0},"color":"#4499cc","waypoints":[]},{"id":"w5","start":{"componentId":"arduino-mega","pinName":"10","x":0,"y":0},"end":{"componentId":"DRIVER","pinName":"ENB","x":0,"y":0},"color":"#4499cc","waypoints":[]},{"id":"w6","start":{"componentId":"BATTERY","pinName":