UP_ENABLE,\n        .master.clk_speed = 100000,\n    };\n    ESP_ERROR_CHECK(i2c_param_config(I2C_PORT, &conf));\n    ESP_ERROR_CHECK(i2c_driver_install(I2C_PORT, I2C_MODE_MASTER, 0, 0, 0));\n\n    write_reg(0x00, 0x70); // 8-sample averaging, 15 Hz output rate\n    write_reg(0x01, 0x20); // gain 1090 LSB/Ga\n    write_reg(0x02, 0x00); // continuous measurement\n\n    for (;;) {\n        vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(1000));\n        int16_t x, y;\n        read_xy(&x, &y);\n        float heading = atan2f(y, x) * 180.0f / (float)M_PI;\n        if (heading < 0) heading += 360.0f;\n        printf(\"Heading: %.1f\\n\", heading);\n    }\n}\n","overlays":{},"referenceHex":null},"nrf52840_arduino":{"circuit":{"boards":[{"id":"nrf52840-dk","boardKind":"nrf52840-dk","x":60,"y":60}],"components":[{"id":"MAG1","metadataId":"hmc5883l","x":760,"y":120}],"wires":[{"id":"w-P0.21-SDA","start":{"componentId":"nrf52840-dk","pinName":"P0.21","x":0,"y":0},"end":{"componentId":"MAG1","pinName":"SDA","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.27-SCL","start":{"componentId":"nrf52840-dk","pinName":"P0.27","x":0,"y":0},"end":{"componentId":"MAG1","pinName":"SCL","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-VDD-VCC","start":{"componentId":"nrf52840-dk","pinName":"VDD","x":0,"y":0},"end":{"componentId":"MAG1","pinName":"VCC","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-MAG1-GND","start":{"componentId":"MAG1","pinName":"GND","x":0,"y":0},"end":{"componentId":"nrf52840-dk","pinName":"GND.1","x":0,"y":0},"color":"#000000","waypoints":[]}]},"pinout":{"HMC5883L":{"SDA":"P0_21","SCL":"P0_27"}},"tests":[{"target":"atmega2560_arduino","part":"hmc5883l","name":"compass","pin":20},{"target":"atmega328p_arduino","part":"hmc5883l","name":"compass","pin":"A4"},{"target":"esp32s3_espidf","part":"hmc5883l","name":"compass","pin":38},{"target":"esp32s3_arduino","part":"hmc5883l","name":"compass","pin":38},{"target":"nrf52840_zephyr","part":"hmc5883l","name":