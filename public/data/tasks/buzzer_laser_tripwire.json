resistor","name":"light","pin":"P0.03"},{"target":"nrf52840_arduino","part":"ky-008","name":"laser","pin":"P1.12"},{"target":"nrf52840_arduino","part":"buzzer","name":"buzzer","pin":"P1.15"},{"at":0,"set":"light.lightLevel = 900"},{"at":2400,"expect":"laser.laserOn == true"},{"at":2400,"expect":"buzzer.hasSignal == false"},{"at":2500,"set":"light.lightLevel = 100"},{"at":4900,"expect":"buzzer.hasSignal == true"},{"at":5000,"set":"light.lightLevel = 900"},{"at":7400,"expect":"buzzer.hasSignal == false"}],"testOrigin":"tasks/buzzer_laser_tripwire/test.jsonl","testSha256":"88f422d263ee5b8f3b9585b63efb647929186188236290230109d2e49d713918","source":"const int LASER_PIN = 10;\nconst int BUZZER_PIN = 11;\nconst int LDR_PIN = 9;\n\n// KY-018 output voltage rises as light falls; above half scale the beam is blocked.\nconst int BLOCKED_THRESHOLD = 2048;\nconst int ALARM_FREQ_HZ = 2000;\n\nbool alarmOn = false;\n\nvoid setup() {\n  pinMode(LASER_PIN, OUTPUT);\n  digitalWrite(LASER_PIN, HIGH);\n  analogReadResolution(12);\n}\n\nvoid loop() {\n  bool blocked = analogRead(LDR_PIN) > BLOCKED_THRESHOLD;\n  if (blocked && !alarmOn) {\n    tone(BUZZER_PIN, ALARM_FREQ_HZ);\n    alarmOn = true;\n  } else if (!blocked && alarmOn) {\n    noTone(BUZZER_PIN);\n    alarmOn = false;\n  }\n  delay(10);\n}\n","overlays":{},"referenceHex":null},"esp32s3_espidf":{"circuit":{"boards":[{"id":"esp32-s3","boardKind":"esp32-s3","x":60,"y":60}],"components":[{"id":"LZ1","metadataId":"ky-008","x":300,"y":120},{"id":"K1","metadataId":"ky-018-photoresistor","x":384,"y":120,"properties":{}},{"id":"BZ1","metadataId":"buzzer","x":468,"y":104}],"wires":[{"id":"w-10-signal","start":{"componentId":"esp32-s3","pinName":"10","x":0,"y":0},"end":{"componentId":"LZ1","pinName":"signal","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-5V-LZ1","start":{"componentId":"esp32-s3","pinName":"5V","x":0,"y":0},"end":{"componentId":"LZ1","pinName":"VCC","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-LZ1-GND"