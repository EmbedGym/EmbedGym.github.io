{"id":"mpu6050_read_button_display","name":"Mpu6050 Read Button Display","description":"On each button press, read the accelerometer and gyroscope data from the MPU6050 over I2C and display the X-axis values on the LCD1602: the first row formatted printf-style as \"Ax(g): %.2f\" (acceleration in g) and the second row as \"Gx(dps): %.2f\" (angular rate in degrees per second). Implement a GPIO interrupt on the pull-down push button so that every press updates the display.","level":3,"parts":["lcd1602","mpu6050","pushbutton"],"targets":["atmega328p_arduino","atmega2560_arduino","esp32s3_arduino","esp32s3_espidf","nrf52840_arduino","nrf52840_zephyr"],"application":"Motion and Navigation","interface":"I2C/SPI","protocols":["I2C/SPI","GPIO Input","GPIO/PWM Output"],"variants":{"atmega328p_arduino":{"circuit":{"boards":[{"id":"arduino-uno","boardKind":"arduino-uno","x":100,"y":200}],"components":[{"id":"BTN","metadataId":"pushbutton","x":100,"y":135},{"id":"R_PD","metadataId":"resistor-10k","x":187,"y":169},{"id":"IMU1","metadataId":"mpu6050","x":266,"y":119},{"id":"LCD1","metadataId":"lcd1602","x":368,"y":44}],"wires":[{"id":"w-2-BTN","start":{"componentId":"arduino-uno","pinName":"2","x":0,"y":0},"end":{"componentId":"BTN","pinName":"1.l","x":0,"y":0},"color":"#0000ff","waypoints":[]},{"id":"w-BTN-5V","start":{"componentId":"BTN","pinName":"2.l","x":0,"y":0},"end":{"componentId":"arduino-uno","pinName":"5V","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-2-RPD","start":{"componentId":"arduino-uno","pinName":"2","x":0,"y":0},"end":{"componentId":"R_PD","pinName":"1","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-RPD-GND","start":{"componentId":"R_PD","pinName":"2","x":0,"y":0},"end":{"componentId":"arduino-uno","pinName":"GND","x":0,"y":0},"color":"#000000","waypoints":[]},{"id":"w-A4-SDA","start":{"componentId":"arduino-uno","pinName":"A4","x":0,"y":0},"end":{"componentId":"IMU1","pinName":"SDA","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-A5-