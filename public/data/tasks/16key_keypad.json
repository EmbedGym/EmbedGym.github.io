ICKS(50));\n                }\n            }\n            gpio_set_level(row_pins[r], 1);\n        }\n        vTaskDelay(1);\n    }\n}\n","overlays":{},"referenceHex":null},"nrf52840_arduino":{"circuit":{"boards":[{"id":"nrf52840-dk","boardKind":"nrf52840-dk","x":60,"y":60}],"components":[{"id":"KP1","metadataId":"membrane-keypad","x":60,"y":440}],"wires":[{"id":"w-P1.08-R1","start":{"componentId":"nrf52840-dk","pinName":"P1.08","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.01-R2","start":{"componentId":"nrf52840-dk","pinName":"P1.01","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R2","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.02-R3","start":{"componentId":"nrf52840-dk","pinName":"P1.02","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R3","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.27-R4","start":{"componentId":"nrf52840-dk","pinName":"P0.27","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.21-C1","start":{"componentId":"nrf52840-dk","pinName":"P0.21","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C1","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P0.23-C2","start":{"componentId":"nrf52840-dk","pinName":"P0.23","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C2","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P1.14-C3","start":{"componentId":"nrf52840-dk","pinName":"P1.14","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C3","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P1.13-C4","start":{"componentId":"nrf52840-dk","pinName":"P1.13","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C4","x":0,"y":0},"color":"#ffaa00","waypoints":[]}]},"pinout":{"Keypad":{"R1":"P1_08","R2":"P1_01","R3":"P1_02","R4":"P0_27","C1":"P0_21","C2":"P0_23","C3":"P1_14","C4":"P1_13"}},"tests":[{"target":"atmega2560_arduino","part":"membrane-keypad","name":"keypad","pin":9},{"target":"atme