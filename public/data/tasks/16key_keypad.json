 }\n  return key;\n}\n\nvoid loop() {\n  char key = scanKey();\n  if (key != 0 && lastKey == 0) {\n    Serial.print(\"Key Pressed: \");\n    Serial.println(key);\n  }\n  lastKey = key;\n  delay(20);\n}\n","overlays":{},"referenceHex":null},"nrf52840_zephyr":{"circuit":{"boards":[{"id":"nrf52840-dk","boardKind":"nrf52840-dk","x":60,"y":60}],"components":[{"id":"KP1","metadataId":"membrane-keypad","x":60,"y":440}],"wires":[{"id":"w-P1.08-R1","start":{"componentId":"nrf52840-dk","pinName":"P1.08","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R1","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.01-R2","start":{"componentId":"nrf52840-dk","pinName":"P1.01","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R2","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P1.02-R3","start":{"componentId":"nrf52840-dk","pinName":"P1.02","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R3","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.27-R4","start":{"componentId":"nrf52840-dk","pinName":"P0.27","x":0,"y":0},"end":{"componentId":"KP1","pinName":"R4","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-P0.21-C1","start":{"componentId":"nrf52840-dk","pinName":"P0.21","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C1","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P0.23-C2","start":{"componentId":"nrf52840-dk","pinName":"P0.23","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C2","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P1.14-C3","start":{"componentId":"nrf52840-dk","pinName":"P1.14","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C3","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-P1.13-C4","start":{"componentId":"nrf52840-dk","pinName":"P1.13","x":0,"y":0},"end":{"componentId":"KP1","pinName":"C4","x":0,"y":0},"color":"#ffaa00","waypoints":[]}]},"pinout":{"Keypad":{"R1":"row-1","R2":"row-2","R3":"row-3","R4":"row-4","C1":"col-1","C2":"col-2","C3":"col-3","C4":"col-4"}},"tests":[{"target":"atmega2560_arduino"