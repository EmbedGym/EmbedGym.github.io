e unsigned long elapsedMs = 0;\nvolatile bool running = false;\nvolatile bool done = false;\n\nvoid onButton() {\n  startMs = millis();\n  running = true;\n}\n\nvoid onShock() {\n  if (running) {\n    elapsedMs = millis() - startMs;\n    running = false;\n    done = true;\n  }\n}\n\nvoid setup() {\n  lcd.begin(16, 2);\n  pinMode(BUTTON_PIN, INPUT);\n  pinMode(SHOCK_PIN, INPUT);\n  attachInterrupt(digitalPinToInterrupt(BUTTON_PIN), onButton, RISING);\n  attachInterrupt(digitalPinToInterrupt(SHOCK_PIN), onShock, RISING);\n  lcd.print(\"Press to start\");\n}\n\nvoid loop() {\n  if (running) {\n    lcd.setCursor(0, 0);\n    lcd.print(\"Timing...       \");\n  }\n  if (done) {\n    done = false;\n    lcd.clear();\n    lcd.print(\"Time: \");\n    lcd.print(elapsedMs);\n    lcd.print(\" ms\");\n  }\n  delay(20);\n}\n","overlays":{},"referenceHex":null},"atmega2560_arduino":{"circuit":{"boards":[{"id":"arduino-mega","boardKind":"arduino-mega","x":100,"y":200}],"components":[{"id":"BTN","metadataId":"pushbutton","x":100,"y":135},{"id":"R_PD","metadataId":"resistor-10k","x":187,"y":169},{"id":"SH1","metadataId":"shock-sensor","x":266,"y":120},{"id":"LCD1","metadataId":"lcd1602","x":350,"y":44}],"wires":[{"id":"w-2-BTN","start":{"componentId":"arduino-mega","pinName":"2","x":0,"y":0},"end":{"componentId":"BTN","pinName":"1.l","x":0,"y":0},"color":"#0000ff","waypoints":[]},{"id":"w-BTN-5V","start":{"componentId":"BTN","pinName":"2.l","x":0,"y":0},"end":{"componentId":"arduino-mega","pinName":"5V","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-2-RPD","start":{"componentId":"arduino-mega","pinName":"2","x":0,"y":0},"end":{"componentId":"R_PD","pinName":"1","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-RPD-GND","start":{"componentId":"R_PD","pinName":"2","x":0,"y":0},"end":{"componentId":"arduino-mega","pinName":"GND","x":0,"y":0},"color":"#000000","waypoints":[]},{"id":"w-3-signal","start":{"componentId":"arduino-mega","pinName":"3","x":0,"y":0},"end":{"compone