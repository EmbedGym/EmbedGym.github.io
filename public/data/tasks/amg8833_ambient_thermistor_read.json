{"id":"amg8833_ambient_thermistor_read","name":"Amg8833 Ambient Thermistor Read","description":"Read the AMG8833's on-board thermistor register (its own ambient temperature, separate from the 64-pixel IR array) over I2C and print its temperature in degrees Celsius to the serial console once per second. The AMG8833 is at I2C address 0x69.","level":1,"parts":["amg8833"],"targets":["atmega328p_arduino","atmega2560_arduino","esp32s3_arduino","esp32s3_espidf","nrf52840_arduino","nrf52840_zephyr"],"application":"Presence and Distance","interface":"I2C/SPI","protocols":["I2C/SPI"],"variants":{"atmega328p_arduino":{"circuit":{"boards":[{"id":"arduino-uno","boardKind":"arduino-uno","x":100,"y":200}],"components":[{"id":"THERM1","metadataId":"amg8833","x":320,"y":440}],"wires":[{"id":"w-SDA","start":{"componentId":"arduino-uno","pinName":"A4","x":0,"y":0},"end":{"componentId":"THERM1","pinName":"SDA","x":0,"y":0},"color":"#00aa00","waypoints":[]},{"id":"w-SCL","start":{"componentId":"arduino-uno","pinName":"A5","x":0,"y":0},"end":{"componentId":"THERM1","pinName":"SCL","x":0,"y":0},"color":"#ffaa00","waypoints":[]},{"id":"w-VIN","start":{"componentId":"arduino-uno","pinName":"5V","x":0,"y":0},"end":{"componentId":"THERM1","pinName":"VIN","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-GND","start":{"componentId":"arduino-uno","pinName":"GND","x":0,"y":0},"end":{"componentId":"THERM1","pinName":"GND","x":0,"y":0},"color":"#000000","waypoints":[]}]},"pinout":{"AMG8833":{"SDA":"A4","SCL":"A5"}},"tests":[{"target":"atmega2560_arduino","part":"amg8833","name":"thermal","pin":20},{"target":"atmega328p_arduino","part":"amg8833","name":"thermal","pin":"A4"},{"target":"esp32s3_espidf","part":"amg8833","name":"thermal","pin":38},{"target":"esp32s3_arduino","part":"amg8833","name":"thermal","pin":38},{"target":"nrf52840_zephyr","part":"amg8833","name":"thermal","pin":"P0.21"},{"target":"nrf52840_arduino","part":"amg8833","name":"thermal","pin":"P0.21"},{"at":0,"set":"thermal.the