atic void blip(int on_ms)\n{\n    gpio_set_level(LED_PIN, 1);\n    vTaskDelay(pdMS_TO_TICKS(on_ms));\n    gpio_set_level(LED_PIN, 0);\n    vTaskDelay(pdMS_TO_TICKS(GAP_SYM));\n}\n\nstatic void letter_s(void)\n{\n    blip(DIT); blip(DIT); blip(DIT);\n}\n\nstatic void letter_o(void)\n{\n    blip(DAH); blip(DAH); blip(DAH);\n}\n\nvoid app_main(void)\n{\n    gpio_reset_pin(LED_PIN);\n    gpio_set_direction(LED_PIN, GPIO_MODE_OUTPUT);\n    for (;;) {\n        letter_s();\n        vTaskDelay(pdMS_TO_TICKS(GAP_LTR - GAP_SYM));\n        letter_o();\n        vTaskDelay(pdMS_TO_TICKS(GAP_LTR - GAP_SYM));\n        letter_s();\n        vTaskDelay(pdMS_TO_TICKS(GAP_WORD - GAP_SYM));\n    }\n}\n","overlays":{},"referenceHex":null},"nrf52840_arduino":{"circuit":{"boards":[{"id":"nrf52840-dk","boardKind":"nrf52840-dk","x":60,"y":60}],"components":[{"id":"R1","metadataId":"resistor","x":720,"y":160,"properties":{"value":"220"}},{"id":"L1","metadataId":"led","x":820,"y":120,"properties":{"color":"red"}}],"wires":[{"id":"w-P1.15-R1","start":{"componentId":"nrf52840-dk","pinName":"P1.15","x":0,"y":0},"end":{"componentId":"R1","pinName":"1","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-R1-L1","start":{"componentId":"R1","pinName":"2","x":0,"y":0},"end":{"componentId":"L1","pinName":"A","x":0,"y":0},"color":"#ff0000","waypoints":[]},{"id":"w-L1-GND","start":{"componentId":"L1","pinName":"C","x":0,"y":0},"end":{"componentId":"nrf52840-dk","pinName":"GND.1","x":0,"y":0},"color":"#000000","waypoints":[]}]},"pinout":{"LED":{"signal":"P1_15"}},"tests":[{"target":"atmega2560_arduino","part":"led","name":"led","pin":3},{"target":"atmega328p_arduino","part":"led","name":"led","pin":3},{"target":"esp32s3_espidf","part":"led","name":"led","pin":10},{"target":"esp32s3_arduino","part":"led","name":"led","pin":10},{"target":"nrf52840_zephyr","part":"led","name":"led","pin":"P1.15"},{"target":"nrf52840_arduino","part":"led","name":"led","pin":"P1.15"},{"at":100,"expect":"led.value == true"},